# Slider PVP Contract - Environment Variables Example
# Copy this file to .env in the project root and fill in your values

# ============================================================================
# SOLANA NETWORK CONFIGURATION
# ============================================================================

# Active environment (devnet, mainnet, localnet)
SOLANA_ENVIRONMENT=devnet

# Custom RPC endpoints (optional - overrides config/environments.json)
# DEVNET_RPC_URL=https://api.devnet.solana.com
# MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
# LOCALNET_RPC_URL=http://127.0.0.1:8899

# ============================================================================
# WALLET CONFIGURATION
# ============================================================================

# Wallet paths (optional - overrides config/environments.json)
# DEVNET_WALLET=~/.config/solana/id.json
# MAINNET_WALLET=~/.config/solana/mainnet-deploy.json
# LOCALNET_WALLET=~/.config/solana/id.json

# ============================================================================
# PROGRAM CONFIGURATION
# ============================================================================

# Program ID (automatically generated during first deployment)
# PROGRAM_ID=HbatSgiDtdwtnEix8oJzCQMF3WXx4aj2uF7qRg89Brp5

# Program keypair paths
# DEVNET_PROGRAM_KEYPAIR=target/deploy/slider_pvp-keypair.json
# MAINNET_PROGRAM_KEYPAIR=target/deploy/slider_pvp-mainnet-keypair.json

# ============================================================================
# MONITORING & ALERTS
# ============================================================================

# Slack webhook for deployment notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Discord webhook for deployment notifications
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK

# Email for critical alerts
# ALERT_EMAIL=your-email@example.com

# ============================================================================
# DEPLOYMENT SETTINGS
# ============================================================================

# Skip confirmation prompts (DANGEROUS - for CI/CD only)
# SKIP_CONFIRMATIONS=false

# Enable verbose logging
# VERBOSE=true

# Deployment backup directory
# BACKUP_DIR=backups

# ============================================================================
# TESTING CONFIGURATION
# ============================================================================

# Enable post-deployment tests
# RUN_TESTS=true

# Test timeout (milliseconds)
# TEST_TIMEOUT=60000

# Test player wallets for devnet testing
# TEST_PLAYER1_KEYPAIR=devnet-testing/test-player1.json
# TEST_PLAYER2_KEYPAIR=devnet-testing/test-player2.json

# ============================================================================
# SECURITY
# ============================================================================

# Enable security checks before deployment
# SECURITY_CHECKS=true

# Require audit confirmation for mainnet
# REQUIRE_AUDIT=true

# Enable rate limiting for RPC calls
# RATE_LIMIT_ENABLED=true

# ============================================================================
# NOTES
# ============================================================================

# 1. Never commit .env file to version control
# 2. Ensure .env is in .gitignore
# 3. Use strong, unique values for production
# 4. Rotate credentials regularly
# 5. Store mainnet credentials in secure key management system

